@model Survey.FrameWork.common.VoteQuestion.CreateVoteQuestionCommand

<link rel="stylesheet" href="~/assets/css/question-editor.css" asp-append-version="true" />

<section class="question-editor" dir="rtl" aria-labelledby="question-editor-title">
    <header class="question-editor-header">
        <h1 id="question-editor-title">ایجاد سوال</h1>
    </header>

    <form asp-action="Create" asp-controller="VoteQuestion" id="kt_add_Question_form" class="form question-editor-form">
        @Html.AntiForgeryToken()

        <div class="question-editor-overview">
            <section class="question-editor-panel" aria-labelledby="question-editor-content-title">
                <h2 id="question-editor-content-title" class="question-editor-section-title">متن سوال</h2>
                <div class="question-editor-fields">
                    <div>
                        <label for="Title" class="form-label required">عنوان سوال</label>
                        <textarea asp-for="Title" class="form-control form-control-solid" rows="3"
                                  placeholder="متن سوال را وارد کنید" maxlength="200" aria-required="true"></textarea>
                    </div>
                    <div>
                        <label for="ValidationMessage" class="form-label">پیام راهنما</label>
                        <input type="text" class="form-control form-control-solid" asp-for="ValidationMessage" placeholder="مثلا یک گزینه را انتخاب کنید" maxlength="300" />
                    </div>
                </div>
            </section>

            <section class="question-editor-panel" aria-labelledby="question-editor-meta-title">
                <h2 id="question-editor-meta-title" class="question-editor-section-title">دسته‌بندی و کلیدواژه‌ها</h2>
                <div class="question-editor-fields">
                    <div>
                        <label for="VoteQuestionGroupId" class="form-label required">گروه</label>
                        <select id="VoteQuestionGroupId" name="VoteQuestionGroupId" data-control="select2" data-placeholder=" نام گروه را انتخاب نمایید" class="form-select form-select-solid ">
                        <option value=""></option>
                        </select>
                    </div>
                    <div class="subGroup">
                        <label for="SubVoteQuestionGroupId" class="form-label required">زیرگروه</label>
                        <select id="SubVoteQuestionGroupId" name="SubVoteQuestionGroupId" data-control="select2" data-placeholder=" نام زیر گروه را انتخاب نمایید" class="form-select form-select-solid ">
                        <option value=""></option>
                        </select>
                    </div>
                    <div>
                        <label for="KeyWord" class="form-label required">کلمات کلیدی</label>
                        <input asp-for="KeyWord" class="form-control form-control-solid" aria-required="true"
                               aria-describedby="tag-error-message" />
                        <div class="error-message fs-7 text-muted display-none" id="tag-error-message"></div>
                    </div>
                </div>
            </section>
        </div>

        <div class="question-editor-type-layout">
            <section class="question-editor-panel question-editor-type-picker" aria-labelledby="question-editor-type-title">
                <h2 id="question-editor-type-title" class="question-editor-section-title">نوع پرسش</h2>
                <p class="question-editor-type-status" id="question-editor-type-status" role="status">در حال بارگذاری انواع پرسش…</p>
                <div id="VotequestionTypeIdSearch" role="radiogroup" aria-labelledby="question-editor-type-title"
                     aria-required="true"></div>
            </section>

            <div class="question-editor-panel question-editor-type-details">
                <p class="question-editor-type-empty">با انتخاب نوع پرسش، تنظیمات آن اینجا نمایش داده می‌شود.</p>
                <p class="question-editor-type-empty question-editor-type-no-settings">این نوع پرسش تنظیمات دیگری ندارد.</p>
                                        <div class="showDetailQuestion" id="question-editor-type-settings">
                                            <div class="d-none showDetailQuestionItem" id="RadioShowcase-Add">
                                                <div class="question-editor-options">
                                                    <h3 class="question-editor-section-title">گزینه‌های سوال</h3>
                                                    <div class="question-editor-option-guide">
                                                        <p id="vote-option-priority-help">اولویت، ترتیب نمایش گزینه‌ها را مشخص می‌کند.</p>
                                                        <p id="vote-option-weight-help">وزن گزینه را با عدد صحیح از منفی ۱۰ تا ۱۰ وارد کنید.</p>
                                                        <details class="question-editor-weight-guide">
                                                            <summary>راهنمای وزن‌گذاری</summary>
                                                            <ul>
                                                                <li>برای گزینه‌های سوال‌های با بار معنایی منفی، وزن مثبت تعیین کنید.</li>
                                                                <li>برای سوال‌های با بار معنایی مثبت، وزن گزینه‌های مثبت و منفی را قرینه تعیین کنید.</li>
                                                            </ul>
                                                        </details>
                                                    </div>
                                                    <div class="question-editor-options-table">
                                                        <div class="d-flex flex-column">
                                                            <div id="kt_repeater_RadioShowcase">
                                                                <div class="form-group">
                                                                    <div data-repeater-list="item_List">
                                                                        <div class="vote-option-header vote-option-grid" aria-hidden="true">
                                                                            <div class="header-cell">متن گزینه</div>
                                                                            <div class="header-cell text-center">انتخاب عکس</div>
                                                                            <div class="header-cell text-center">اولویت</div>
                                                                            <div class="header-cell text-center">وزن</div>
                                                                            <div class="header-cell text-center">عملیات</div>
                                                                        </div>

                                                                        @foreach (var item in Model.VoteQuestionItems?.Where(x => x != null).DefaultIfEmpty() ?? new[] { Model.VoteQuestionItems?.FirstOrDefault() })
                                                                        {
                                                                            var isEmptyOption = string.IsNullOrWhiteSpace(item?.Title) && string.IsNullOrWhiteSpace(item?.ImageUrl);
                                                                            var optionWeight = isEmptyOption ? 1 : item?.Weight ?? 1;
                                                                            <div data-repeater-item class="vote-option-row vote-option-grid">

                                                                                <div class="grid-cell">
                                                                                    <span class="question-editor-mobile-label" aria-hidden="true">متن گزینه</span>
                                                                                    <input type="text"
                                                                                           class="form-control form-control-solid required VoteQuestionItemTitle"
                                                                                           name="VoteQuestionItemTitle"
                                                                                           value="@(item?.Title)"
                                                                                           placeholder="متن گزینه" aria-label="متن گزینه"
                                                                                           maxlength="200" />
                                                                                </div>

                                                                                <div class="grid-cell d-flex justify-content-center">
                                                                                    <span class="question-editor-mobile-label" aria-hidden="true">تصویر</span>
                                                                                    <div class="file-preview-box w-100 align-items-center justify-content-center gap-2 flex-wrap">

                                                                                        <!-- دکمه انتخاب / تیک سبز -->
                                                                                        <div class="d-inline-flex align-items-center gap-2">
                                                                                            <label class="btn chooseImageQuestion btn-md my-1 js-label-trigger @(string.IsNullOrEmpty(item?.ImageUrl) ? "" : "d-none")">
                                                                                                <i class="ki-duotone ki-upload fs-6 me-1"></i>
                                                                                                انتخاب کنید

                                                                                                <input type="file"
                                                                                                       class="d-none file-input-option ImageFileCreate"
                                                                                                       accept="image/*" />
                                                                                            </label>

                                                                                            <!-- تیک سبز: دقیقاً هم‌تراز وسط دکمه -->
                                                                                        </div>
                                                                                        <!-- پیش‌نمایش عکس (وقتی عکس جدید انتخاب شد یا عکس قبلی هست) -->
                                                                                        <div class="image-preview-wrapper @(string.IsNullOrEmpty(item?.ImageUrl) ? "d-none" : "")">
                                                                                            <button type="button" class="remove-image-btn js-remove-image" title="حذف عکس">×</button>
                                                                                            <img src="@(item?.ImageUrl)" class="option-image-preview" alt="preview" />
                                                                                        </div>
                                                                                        <span class="js-upload-status d-none align-items-center"
                                                                                              title="تصویر انتخاب و بارگذاری شد">
                                                                                            <i class="fas fa-check-circle text-success fs-4"></i>
                                                                                        </span>


                                                                                    </div>
                                                                                </div>

                                                                                <div class="grid-cell d-flex justify-content-center">
                                                                                    <span class="question-editor-mobile-label" aria-hidden="true">اولویت</span>
                                                                                    <input type="number"
                                                                                           class="form-control form-control-solid w-100 OrderIndex"
                                                                                           name="OrderIndex"
                                                                                           value="@(item?.OrderIndex == 0 && string.IsNullOrWhiteSpace(item?.Title) ? null : item?.OrderIndex)"
                                                                                           placeholder="اولویت"
                                                                                           aria-label="اولویت گزینه"
                                                                                           aria-describedby="vote-option-priority-help"
                                                                                           min="0" max="999" step="1" required />
                                                                                </div>

                                                                                <div class="grid-cell d-flex justify-content-center">
                                                                                    <span class="question-editor-mobile-label" aria-hidden="true">وزن</span>
                                                                                    <div class="input-group input-group-sm flex-nowrap" dir="ltr">
                                                                                        <button type="button" class="btn btn-light px-2 js-option-weight-step"
                                                                                                data-weight-step="-1" aria-label="کاهش وزن گزینه">−</button>
                                                                                        <input type="number" class="form-control form-control-solid text-center px-1 Weight"
                                                                                               name="Weight" value="@Convert.ToString(optionWeight, System.Globalization.CultureInfo.InvariantCulture)" min="-10" max="10" step="1"
                                                                                               aria-label="وزن گزینه" aria-describedby="vote-option-weight-help" required />
                                                                                        <button type="button" class="btn btn-light px-2 js-option-weight-step"
                                                                                                data-weight-step="1" aria-label="افزایش وزن گزینه">+</button>
                                                                                    </div>
                                                                                </div>

                                                                                <div class="grid-cell text-center">
                                                                                    <button type="button" aria-label="حذف گزینه" data-repeater-delete class="btn btn-icon btn-sm btn-light-danger">
                                                                                        <i class="fonticon-trash fs-2x"></i>
                                                                                    </button>
                                                                                </div>
                                                                            </div>
                                                                        }


                                                                    </div>
                                                                </div>
                                                                <div class="d-flex flex-stack justify-content-end mt-3">
                                                                    <button type="button" data-repeater-create class="btn btn-sm btn-light-primary">
                                                                        <i class="la la-plus" aria-hidden="true"></i> افزودن گزینه
                                                                    </button>
                                                                </div>

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>



                                            <div class="d-none mb-10 fv-row showDetailQuestionItem" id="NumberShowcase-Add">
                                                <div class="card card-flush py-4">
                                                    <div class="px-10 py-1">
                                                        <label class="d-flex align-items-center fs-5 fw-bold" name="AgreementShowcase">
                                                            <span class="">   عددی</span>
                                                            <i class="fas fa-exclamation-circle ms-2 fs-7" data-bs-toggle="tooltip" title=" در صفحه پرسشنامه تکمیل می شود"></i>
                                                        </label>
                                                    </div>
                                                    <div class="separator my-3"></div>
                                                    <div class="p-2">

                                                        <div class="alert alert-warning d-flex align-items-center p-5 mb-10">
                                                            <span class="svg-icon svg-icon-2hx svg-icon-warning me-4">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                                    <path opacity="0.3" d="M20.5543 4.37824L12.1798 2.02473C12.0626 1.99176 11.9376 1.99176 11.8203 2.02473L3.44572 4.37824C3.18118 4.45258 3 4.6807 3 4.93945V13.569C3 14.6914 3.48509 15.8404 4.4417 16.984C5.17231 17.8575 6.18314 18.7345 7.446 19.5909C9.56752 21.0295 11.6566 21.912 11.7445 21.9488C11.8258 21.9829 11.9129 22 12.0001 22C12.0872 22 12.1744 21.983 12.2557 21.9488C12.3435 21.912 14.4326 21.0295 16.5541 19.5909C17.8169 18.7345 18.8277 17.8575 19.5584 16.984C20.515 15.8404 21 14.6914 21 13.569V4.93945C21 4.6807 20.8189 4.45258 20.5543 4.37824Z" fill="black"></path>
                                                                    <path d="M10.5606 11.3042L9.57283 10.3018C9.28174 10.0065 8.80522 10.0065 8.51412 10.3018C8.22897 10.5912 8.22897 11.0559 8.51412 11.3452L10.4182 13.2773C10.8099 13.6747 11.451 13.6747 11.8427 13.2773L15.4859 9.58051C15.771 9.29117 15.771 8.82648 15.4859 8.53714C15.1948 8.24176 14.7183 8.24176 14.4272 8.53714L11.7002 11.3042C11.3869 11.6221 10.874 11.6221 10.5606 11.3042Z" fill="black"></path>
                                                                </svg>
                                                            </span>
                                                            <div class="d-flex flex-column">
                                                                <h4 class="mb-1 text-warning"> توضیحات تکمیلی</h4>
                                                                <span>در صورتی که سوال مورد نظر دارای بازه خاصی باشد می توان حداقل و یا حداکثر بازه را در فرم نظرسنجی وارد نمود. </span>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-none mb-10 fv-row showDetailQuestionItem" id="TextInputShowcase-Add">
                                                <div class="card card-flush py-4">
                                                    <div class="px-10 py-1">
                                                        <label class="d-flex align-items-center fs-5 fw-bold" name="AgreementShowcase">
                                                            <span class="">   تشریحی</span>
                                                            <i class="fas fa-exclamation-circle ms-2 fs-7" data-bs-toggle="tooltip" title=" در صفحه پرسشنامه تکمیل می شود"></i>
                                                        </label>
                                                    </div>
                                                    <div class="separator my-3"></div>
                                                    <div class="card-body">

                                                        <div class="alert alert-warning d-flex align-items-center p-5 mb-10">
                                                            <span class="svg-icon svg-icon-2hx svg-icon-warning me-4">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                                    <path opacity="0.3" d="M20.5543 4.37824L12.1798 2.02473C12.0626 1.99176 11.9376 1.99176 11.8203 2.02473L3.44572 4.37824C3.18118 4.45258 3 4.6807 3 4.93945V13.569C3 14.6914 3.48509 15.8404 4.4417 16.984C5.17231 17.8575 6.18314 18.7345 7.446 19.5909C9.56752 21.0295 11.6566 21.912 11.7445 21.9488C11.8258 21.9829 11.9129 22 12.0001 22C12.0872 22 12.1744 21.983 12.2557 21.9488C12.3435 21.912 14.4326 21.0295 16.5541 19.5909C17.8169 18.7345 18.8277 17.8575 19.5584 16.984C20.515 15.8404 21 14.6914 21 13.569V4.93945C21 4.6807 20.8189 4.45258 20.5543 4.37824Z" fill="black"></path>
                                                                    <path d="M10.5606 11.3042L9.57283 10.3018C9.28174 10.0065 8.80522 10.0065 8.51412 10.3018C8.22897 10.5912 8.22897 11.0559 8.51412 11.3452L10.4182 13.2773C10.8099 13.6747 11.451 13.6747 11.8427 13.2773L15.4859 9.58051C15.771 9.29117 15.771 8.82648 15.4859 8.53714C15.1948 8.24176 14.7183 8.24176 14.4272 8.53714L11.7002 11.3042C11.3869 11.6221 10.874 11.6221 10.5606 11.3042Z" fill="black"></path>
                                                                </svg>
                                                            </span>
                                                            <div class="d-flex flex-column">
                                                                <h4 class="mb-1 text-warning"> توضیحات تکمیلی</h4>
                                                                <span>تعداد کاراکترهای مورد نیاز سوال را می توان در فرم نظرسنجی وارد نمود. </span>
                                                            </div>
                                                        </div>

                                                    </div>

                                                </div>

                                            </div>

                                            <div class="d-none mb-10 fv-row showDetailQuestionItem" id="DateTimeShowcase-Add">
                                                <div class="card card-flush py-4">
                                                    <div class="px-10 py-1">
                                                        <label class="d-flex align-items-center fs-5 fw-bold" name="DateTimeShowcase-Add">
                                                            <span class="">   تاریخ</span>
                                                            <i class="fas fa-exclamation-circle ms-2 fs-7" data-bs-toggle="tooltip" title=" در صفحه پرسشنامه تکمیل می شود"></i>
                                                        </label>
                                                    </div>
                                                    <div class="separator my-3"></div>
                                                    <div class="card-body">

                                                        <div class="alert alert-warning d-flex align-items-center p-5 mb-10">
                                                            <span class="svg-icon svg-icon-2hx svg-icon-warning me-4">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                                    <path opacity="0.3" d="M20.5543 4.37824L12.1798 2.02473C12.0626 1.99176 11.9376 1.99176 11.8203 2.02473L3.44572 4.37824C3.18118 4.45258 3 4.6807 3 4.93945V13.569C3 14.6914 3.48509 15.8404 4.4417 16.984C5.17231 17.8575 6.18314 18.7345 7.446 19.5909C9.56752 21.0295 11.6566 21.912 11.7445 21.9488C11.8258 21.9829 11.9129 22 12.0001 22C12.0872 22 12.1744 21.983 12.2557 21.9488C12.3435 21.912 14.4326 21.0295 16.5541 19.5909C17.8169 18.7345 18.8277 17.8575 19.5584 16.984C20.515 15.8404 21 14.6914 21 13.569V4.93945C21 4.6807 20.8189 4.45258 20.5543 4.37824Z" fill="black"></path>
                                                                    <path d="M10.5606 11.3042L9.57283 10.3018C9.28174 10.0065 8.80522 10.0065 8.51412 10.3018C8.22897 10.5912 8.22897 11.0559 8.51412 11.3452L10.4182 13.2773C10.8099 13.6747 11.451 13.6747 11.8427 13.2773L15.4859 9.58051C15.771 9.29117 15.771 8.82648 15.4859 8.53714C15.1948 8.24176 14.7183 8.24176 14.4272 8.53714L11.7002 11.3042C11.3869 11.6221 10.874 11.6221 10.5606 11.3042Z" fill="black"></path>
                                                                </svg>
                                                            </span>
                                                            <div class="d-flex flex-column">
                                                                <h4 class="mb-1 text-warning"> توضیحات تکمیلی</h4>
                                                                <span>در صورتیکه سوال مورد نظر دارای بازه خاصی می باشد ,می توان حداقل و حداکثر تاریخ مجاز را در فرم نظرسنجی وارد نمود. </span>
                                                            </div>
                                                        </div>

                                                    </div>

                                                </div>
                                            </div>



                                            <div class="d-none mb-10 fv-row showDetailQuestionItem" id="InputValid-Add">

                                                <div class="card card-flush py-4">
                                                    <div class="px-10 py-1">
                                                        <label class="d-flex align-items-center fs-5 fw-bold" name="DateTimeShowcase-Add">
                                                            <span class="">   ورودی معتبر</span>
                                                            <i class="fas fa-exclamation-circle ms-2 fs-7" data-bs-toggle="tooltip" title=" در صفحه پرسشنامه تکمیل می شود"></i>
                                                        </label>
                                                    </div>
                                                    <div class="separator my-3"></div>
                                                    <div class="card-body">

                                                        <div class="fv-row mb-6">

                                                            <label class="fs-6 fw-bold mb-1">
                                                                <span class="px-2">نوع ورودی</span>
                                                                <i class="fas fa-exclamation-circle ms-1 fs-7" data-bs-toggle="tooltip" title="نوع ورودی"></i>
                                                            </label>

                                                            <select asp-for="InputPatternId" name="InputPatternId" data-control="select2" data-placeholder="  نوع ورودی  نام  را انتخاب نمایید" tabindex="-1" class="form-select form-select-solid  select2-hidden-accessible" id="InputPatternId">
                                                                <option></option>
                                                            </select>


                                                        </div>

                                                    </div>

                                                </div>


                                            </div>
                                            <div class="d-none mb-10 fv-row showDetailQuestionItem" id="Star-Add">
                                                <div class="card card-flush py-4">
                                                    <div class="px-10 py-1">
                                                        <label class="d-flex align-items-center fs-5 fw-bold" name="Star">
                                                            <span class="">ستاره امتیاز دهی</span>
                                                            <i class="fas fa-exclamation-circle ms-2 fs-7" data-bs-toggle="tooltip" title=" در صفحه پرسشنامه تکمیل می شود"></i>
                                                        </label>
                                                    </div>

                                                    <div class="separator my-3"></div>

                                                    <div class="card-body">

                                                        <div class="alert alert-warning d-flex align-items-center p-5 mb-10">
                                                            <span class="svg-icon svg-icon-2hx svg-icon-warning me-4">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                                    <path opacity="0.3" d="M20.5543 4.37824L12.1798 2.02473C12.0626 1.99176 11.9376 1.99176 11.8203 2.02473L3.44572 4.37824C3.18118 4.45258 3 4.6807 3 4.93945V13.569C3 14.6914 3.48509 15.8404 4.4417 16.984C5.17231 17.8575 6.18314 18.7345 7.446 19.5909C9.56752 21.0295 11.6566 21.912 11.7445 21.9488C11.8258 21.9829 11.9129 22 12.0001 22C12.0872 22 12.1744 21.983 12.2557 21.9488C12.3435 21.912 14.4326 21.0295 16.5541 19.5909C17.8169 18.7345 18.8277 17.8575 19.5584 16.984C20.515 15.8404 21 14.6914 21 13.569V4.93945C21 4.6807 20.8189 4.45258 20.5543 4.37824Z" fill="black"></path>
                                                                    <path d="M10.5606 11.3042L9.57283 10.3018C9.28174 10.0065 8.80522 10.0065 8.51412 10.3018C8.22897 10.5912 8.22897 11.0559 8.51412 11.3452L10.4182 13.2773C10.8099 13.6747 11.451 13.6747 11.8427 13.2773L15.4859 9.58051C15.771 9.29117 15.771 8.82648 15.4859 8.53714C15.1948 8.24176 14.7183 8.24176 14.4272 8.53714L11.7002 11.3042C11.3869 11.6221 10.874 11.6221 10.5606 11.3042Z" fill="black"></path>
                                                                </svg>
                                                            </span>
                                                            <div class="d-flex flex-column">
                                                                <h4 class="mb-1 text-warning"> توضیحات تکمیلی</h4>
                                                                <span>می توان برای این سوال حداکثر 5 ستاره در نظر گرفت. </span>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>

                                            <div class="pane">
                                                <div class="input-box">
                                                    <div class="input-group">
                                                        <input type="tel" id="MobileNumber" class="input mobile-input-type-sms" placeholder="9121234567" value="" maxlength="11" autocomplete="off" />
                                                    </div>
                                                </div>
                                            </div>
                                            break;
                                        case 5: // QRTerminal
                                            <div class="pane">
                                                <div class="input-box">
                                                    <div class="input-group">
                                                        <input type="tel" id="MobileNumber" class="input input-group-addon mobile-input-type-qr" placeholder="" readonly autocomplete="off" />
                                                    </div>
                                                </div>
                                            </div>
                                            break;
                                        default:
                                            <div class="pane">
                                                <div class="input-box">
                                                    <div class="input-group">
                                                        <input type="tel" id="MobileNumber" class="input mobile-input-type-sms" placeholder="9121234567" value="" maxlength="11" autocomplete="off" />
                                                    </div>
                                                </div>
                                            </div>
                                            break;
                                    }


                                </div>
                                <p class="alertFild"></p>
                            </div>
                            <button class="mellat-button btn-nextQst" onclick="sendOtpCode();">ارسال پیامک تایید</button>
                        </div>

                        @*getOtpNumberBox *@
                        <div class="LoginStep2 d-none">
                            <div class="form-holder">
                                <div>
                                    <label class="lblText">
                                        کد <span class="persian-digits">6</span>  رقمی ارسال شده به شماره زیر را وارد نمایید:<br />
                                    </label>
                                    <span class=" MobileNumberChange" onclick="editNumber()">
                                        <span class="svg-icon svg-icon-muted svg-icon-2hx">

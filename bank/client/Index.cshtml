                                            </svg>
                                            <p>ویرایش شماره</p>
                                        </span>
                                        <span id="MobileNumberEnterByUser"></span>
                                    </span>
                                </div>

                                <div class="otpCodeBox">
                                    @switch (Model.ProcessTypeData.SurveyTypeName)
                                    {
                                        case 3: // SMS
                                      
                                        <div class="pane">
                                                <div class="input-box">
                                                    <div class="input-group">
                                                        <input type="tel" id="CodeOtp" class="input input-group-addon" placeholder="" autocomplete="one-time-code" onkeypress="return isNumberKey(event)">
                                                    </div>
                                                </div>
                                            </div>
                                            break;
                                        case 5: // QRTerminal
                                            <div class="pane">
                                                <div class="input-box">
                                                    <div class="input-group">
                                                        <input type="tel" id="CodeOtp" class="input input-group-addon " placeholder="" autocomplete="one-time-code" onkeypress="return isNumberKey(event)">
                                                        <input type="tel" id="CodeOtp" onkeypress="return isNumberKey(event)" readonly autocomplete="off" onkeydown="if(event.keyCode == 13) eventHandlersendOtpCode(event)" onclick="toggleNumberPad()" class="input input-group-addon " placeholder="***" value="" maxlength="11" />
                                                    </div>
                                                </div>
                                            </div>
                                            break;
                                        default:
                                            <div class="otp-container" id="otpContainer">
                                             
                                                <input type="tel" id="otpHidden"
                                                       autocomplete="one-time-code"
                                                       style="position:absolute; opacity:0; pointer-events:none; width:0; height:0;"
                                                       tabindex="-1">

                                                <input type="tel" class="input otp-input" maxlength="1" autocomplete="off" onkeypress="return isNumberKey(event)">
                                                <input type="tel" class="input otp-input" maxlength="1" autocomplete="off" onkeypress="return isNumberKey(event)">
                                                <input type="tel" class="input otp-input" maxlength="1" autocomplete="off" onkeypress="return isNumberKey(event)">
                                                <input type="tel" class="input otp-input" maxlength="1" autocomplete="off" onkeypress="return isNumberKey(event)">
                                                <input type="tel" class="input otp-input" maxlength="1" autocomplete="off" onkeypress="return isNumberKey(event)">
                                                <input type="tel" class="input otp-input" maxlength="1" autocomplete="off" onkeypress="return isNumberKey(event)">
                                            </div>
                                            break;

                                    }

                                    <div id="app" class="otp-timer-neo" dir="rtl">

                                        <div class="otp-timer-neo__card base-timer">

                                            <div class="otp-timer-neo__head">
                                                <span id="base-timer-label" class="otp-timer-neo__label"></span>
                                                <span class="otp-timer-neo__title">زمان باقی‌مانده</span>
                                            </div>

                                            <div class="otp-timer-neo__progress">
                                                <div id="base-timer-progress-remaining" class="otp-timer-neo__progress-bar"></div>
                                            </div>

                                        </div>

                                        <span onclick="SendAgain()" id="textotpCodeBox" class="hidden otp-timer-neo__resend">
                                            <span class="svg-icon svg-icon-muted svg-icon-2hx otp-timer-neo__resend-icon">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                    <path d="M14.5 20.7259C14.6 21.2259 14.2 21.826 13.7 21.926C13.2 22.026 12.6 22.0259 12.1 22.0259C9.5 22.0259 6.9 21.0259 5 19.1259C1.4 15.5259 1.09998 9.72592 4.29998 5.82592L5.70001 7.22595C3.30001 10.3259 3.59999 14.8259 6.39999 17.7259C8.19999 19.5259 10.8 20.426 13.4 19.926C13.9 19.826 14.4 20.2259 14.5 20.7259ZM18.4 16.8259L19.8 18.2259C22.9 14.3259 22.7 8.52593 19 4.92593C16.7 2.62593 13.5 1.62594 10.3 2.12594C9.79998 2.22594 9.4 2.72595 9.5 3.22595C9.6 3.72595 10.1 4.12594 10.6 4.02594C13.1 3.62594 15.7 4.42595 17.6 6.22595C20.5 9.22595 20.7 13.7259 18.4 16.8259Z" fill="#2067d9" />
                                                    <path opacity="0.3" d="M2 3.62592H7C7.6 3.62592 8 4.02592 8 4.62592V9.62589L2 3.62592ZM16 14.4259V19.4259C16 20.0259 16.4 20.4259 17 20.4259H22L16 14.4259Z" fill="#2067d9" />
                                                </svg>
                                            </span>
                                            <span class="otp-timer-neo__resend-text">ارسال مجدد</span>
                                        </span>

                                    </div>
                                </div>
                                <p class="alertFild "></p>
                            </div>

                            <button class="mellat-button btn-nextQst" onclick="VerifiedOtp();">تایید کد</button>
                        </div>
                    </div>

                    @* starterVotepackage *@
                    <div class="starterVotepackage HaveAnimation  d-none">

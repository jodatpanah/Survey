        </div>
    </div>
    <div class="card-body pt-4">
        <table class="table align-middle table-row-dashed  fs-6 gy-5" id="kt_main_table">
            <thead>
                <tr class="text-start fw-bolder fs-7 bg-light">
                    <th class="text-start ps-4 min-w-150px"> @Html.DisplayNameFor(model => model.Result.FirstOrDefault().VotePackageTitle)  </th>
                    <th class="text-start min-w-70px">@Html.DisplayNameFor(model => model.Result.FirstOrDefault().Title)</th>
                    <th class="text-start min-w-70px">@Html.DisplayNameFor(model => model.Result.FirstOrDefault().Content)</th>
                    <th class="text-start min-w-70px">@Html.DisplayNameFor(model => model.Result.FirstOrDefault().SendDateTime)</th>
                    <th class="rounded-end text-start min-w-50px">@Html.DisplayNameFor(model => model.Result.FirstOrDefault().IsActive)</th>
                    <th class="rounded-begin px-15 min-w-50px text-end "> عملیات </th>
                </tr>
            </thead>


            <tbody class="fw-bold text-gray-900">

                @foreach (var item in Model.Result)
                {
                    <tr>
                        <td class="ps-4 limitDataTableHead15">
                            <span class="limitDataTable">
                                @Html.DisplayFor(modelItem => item.VotePackageTitle)
                            </span>
                        </td>
                        <td class="limitDataTableHead15">
                            <span class="limitDataTable">
                                @Html.DisplayFor(modelItem => item.Title)
                            </span>
                        </td>
                        <td class="limitDataTableHead15">
                            <span class="limitDataTable">
                                @Html.DisplayFor(modelItem => item.Content)
                            </span>
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SendDateTimePersian)
                        </td>


                        <td>
                            @if (item.IsActive)
                            {
                                <div class="d-flex">

                                    <label class="form-check form-switch form-check-custom form-check-solid">
                                        <input class="form-check-input change-status-spec-sms-checkbox change-status-spec-sms-checkbox" type="checkbox" id="VoteRequestSpecificationSmsId-@Html.DisplayFor(modelItem => item.VoteRequestSpecificationSmsId)" checked="checked" data-id="@item.VoteRequestSpecificationSmsId" data-status="0" />
                                        <span class="form-check-label fw-bold text-muted">  فعال</span>
                                    </label>
                                </div>

                            }
                            else
                            {
                                <div class="d-flex">

                                    <label class="form-check form-switch form-check-custom form-check-solid">
                                        <input class="form-check-input change-status-spec-sms-checkbox change-status-spec-sms-checkbox" type="checkbox" id="VoteRequestSpecificationSmsId-@Html.DisplayFor(modelItem => item.VoteRequestSpecificationSmsId)" data-id="@item.VoteRequestSpecificationSmsId" data-status="1" />
                                        <span class="form-check-label fw-bold text-muted">غیر فعال</span>
                                    </label>
                                </div>
                            }
                        </td>

                        <td class="text-end ps-5 ">
                            <a class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1 btn-icon-primary btn-text-primary btn-sm px-4 openmodal" title="جزئیات" asp-action="Details" asp-controller="VoteRequestSpecificationSms" asp-route-parentId="@item.VoteRequestSpecificationSmsId">

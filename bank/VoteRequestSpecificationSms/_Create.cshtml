@model Survey.FrameWork.common.VoteRequestSpecificationSms.CreateVoteRequestSpecificationSmsCommand
@{

    ViewData["TitlePage"] = "ایجاد نظرسنجی- روش ارسال پیامک";
    Layout = null;

}

<div class="modal fade" id="kt_modal_add"  aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-850px">

        <div class="modal-content" id="modalcontentAdd">

            <form id="kt_modal_add_form" class="form " enctype="multipart/form-data" asp-action="Create" asp-controller="VoteRequestSpecificationSms">
                @Html.AntiForgeryToken()
                <input type="hidden" />
                <div class="modal-header" id="kt_modal_add_header">
                    <h2 class="fw-bolder">ایجاد نظرسنجی- روش ارسال پیامک</h2>
                    <div id="kt_modal_add_customer_close" class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal" aria-label="Close">
                        <!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
                        <span class="svg-icon svg-icon-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                                <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                            </svg>
                        </span>
                    </div>
                </div>
                <div class="modal-body mx-5 my-6">
                    <div class="row g-9 mb-8">
                        <div class="col-md-6 fv-row">
                            <label class="fs-6 mb-2"><span class="required"> عنوان</span></label>
                            <input class="form-control form-control-solid" asp-for="Title" type="text" id="Title" name="Title" placeholder="عنوان  را وارد کنید" />
                        </div>
                        <div class="col-md-6 fv-row">
                            <label class="fs-6 mb-2"><span> فرم نظرسنجی</span></label>
                            <select class="form-select form-select-solid" data-control="select2" asp-for="VotePackageId" id="VotePackageId" data-placeholder="...انتخاب نمایید">
                                <option value="">انتخاب نمایید...</option>
                            </select>
                            
                        </div>

                        <div class="fv-row">
                            <label class="required fs-6 mb-2"><span> متن پیامک</span></label>
                            <textarea asp-for="Content" class="form-control form-control-solid" rows="3" name="Content" oninput="CountContentChar(this,70)" placeholder="متن پیامک را وارد کنید"></textarea>

                        <div id="charCount">کاراکتر باقی‌مانده: 70</div>
                        </div>

                        <div class="col-md-6 fv-row">
                        <div class="col-md-6 fv-row">
                            <label class="required fs-6 fw-bold mb-1" for="StartDateTime">
                                <span class="px-2"> تاریخ  </span>
                                <i class="fas fa-exclamation-circle ms-1 fs-7" data-bs-toggle="tooltip"></i>
                            </label>
                            <div class="position-relative align-items-center">
                                <span class="svg-icon svg-icon-2 position-absolute mx-4 my-3 z-index-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                        <path opacity="0.3" d="M21 22H3C2.4 22 2 21.6 2 21V5C2 4.4 2.4 4 3 4H21C21.6 4 22 4.4 22 5V21C22 21.6 21.6 22 21 22Z" fill="black" />
                                        <path d="M6 6C5.4 6 5 5.6 5 5V3C5 2.4 5.4 2 6 2C6.6 2 7 2.4 7 3V5C7 5.6 6.6 6 6 6ZM11 5V3C11 2.4 10.6 2 10 2C9.4 2 9 2.4 9 3V5C9 5.6 9.4 6 10 6C10.6 6 11 5.6 11 5ZM15 5V3C15 2.4 14.6 2 14 2C13.4 2 13 2.4 13 3V5C13 5.6 13.4 6 14 6C14.6 6 15 5.6 15 5ZM19 5V3C19 2.4 18.6 2 18 2C17.4 2 17 2.4 17 3V5C17 5.6 17.4 6 18 6C18.6 6 19 5.6 19 5Z" fill="black" />
                                        <path d="M8.8 13.1C9.2 13.1 9.5 13 9.7 12.8C9.9 12.6 10.1 12.3 10.1 11.9C10.1 11.6 10 11.3 9.8 11.1C9.6 10.9 9.3 10.8 9 10.8C8.8 10.8 8.59999 10.8 8.39999 10.9C8.19999 11 8.1 11.1 8 11.2C7.9 11.3 7.8 11.4 7.7 11.6C7.6 11.8 7.5 11.9 7.5 12.1C7.5 12.2 7.4 12.2 7.3 12.3C7.2 12.4 7.09999 12.4 6.89999 12.4C6.69999 12.4 6.6 12.3 6.5 12.2C6.4 12.1 6.3 11.9 6.3 11.7C6.3 11.5 6.4 11.3 6.5 11.1C6.6 10.9 6.8 10.7 7 10.5C7.2 10.3 7.49999 10.1 7.89999 10C8.29999 9.90003 8.60001 9.80003 9.10001 9.80003C9.50001 9.80003 9.80001 9.90003 10.1 10C10.4 10.1 10.7 10.3 10.9 10.4C11.1 10.5 11.3 10.8 11.4 11.1C11.5 11.4 11.6 11.6 11.6 11.9C11.6 12.3 11.5 12.6 11.3 12.9C11.1 13.2 10.9 13.5 10.6 13.7C10.9 13.9 11.2 14.1 11.4 14.3C11.6 14.5 11.8 14.7 11.9 15C12 15.3 12.1 15.5 12.1 15.8C12.1 16.2 12 16.5 11.9 16.8C11.8 17.1 11.5 17.4 11.3 17.7C11.1 18 10.7 18.2 10.3 18.3C9.9 18.4 9.5 18.5 9 18.5C8.5 18.5 8.1 18.4 7.7 18.2C7.3 18 7 17.8 6.8 17.6C6.6 17.4 6.4 17.1 6.3 16.8C6.2 16.5 6.10001 16.3 6.10001 16.1C6.10001 15.9 6.2 15.7 6.3 15.6C6.4 15.5 6.6 15.4 6.8 15.4C6.9 15.4 7.00001 15.4 7.10001 15.5C7.20001 15.6 7.3 15.6 7.3 15.7C7.5 16.2 7.7 16.6 8 16.9C8.3 17.2 8.6 17.3 9 17.3C9.2 17.3 9.5 17.2 9.7 17.1C9.9 17 10.1 16.8 10.3 16.6C10.5 16.4 10.5 16.1 10.5 15.8C10.5 15.3 10.4 15 10.1 14.7C9.80001 14.4 9.50001 14.3 9.10001 14.3C9.00001 14.3 8.9 14.3 8.7 14.3C8.5 14.3 8.39999 14.3 8.39999 14.3C8.19999 14.3 7.99999 14.2 7.89999 14.1C7.79999 14 7.7 13.8 7.7 13.7C7.7 13.5 7.79999 13.4 7.89999 13.2C7.99999 13 8.2 13 8.5 13H8.8V13.1ZM15.3 17.5V12.2C14.3 13 13.6 13.3 13.3 13.3C13.1 13.3 13 13.2 12.9 13.1C12.8 13 12.7 12.8 12.7 12.6C12.7 12.4 12.8 12.3 12.9 12.2C13 12.1 13.2 12 13.6 11.8C14.1 11.6 14.5 11.3 14.7 11.1C14.9 10.9 15.2 10.6 15.5 10.3C15.8 10 15.9 9.80003 15.9 9.70003C15.9 9.60003 16.1 9.60004 16.3 9.60004C16.5 9.60004 16.7 9.70003 16.8 9.80003C16.9 9.90003 17 10.2 17 10.5V17.2C17 18 16.7 18.4 16.2 18.4C16 18.4 15.8 18.3 15.6 18.2C15.4 18.1 15.3 17.8 15.3 17.5Z" fill="black" />
                                    </svg>
                                </span>
                                <input class="form-control form-control-solid  ps-12 StartDateTime" type="text" asp-for="PersianDateTime" placeholder="تاریخ" id="StartDateTime" name="PersianDateTime" data-jdp data-jdp-only-date />
                            </div>
                        </div>

                    </div>



                    <div class="separator separator-dashed my-5"></div>

                    <div class="d-flex flex-stack mb-8">
                        <div class="me-5">
                            <label class="fs-6 fw-bold">وضعیت</label>
                        </div>

                        <label class="form-check form-switch form-check-custom form-check-solid">
                            @if (!Model.IsActive)
                            {
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" checked="checked" id="IsActiveCheck" onchange="ChangeText()" />
                                <span class="form-check-label fw-bold text-muted" id="IsActiveText">فعال</span>
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="IsActiveCheck" onchange="ChangeText()" />
                                <span class="form-check-label fw-bold text-muted" id="IsActiveText">غیرفعال</span>

                            }

                        </label>

                        <div class="separator separator-dashed my-5"></div>

                    </div>




                    <ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x fs-5 fw-bolder">
                        <li class="nav-item">
                            <a class="nav-link text-active-primary p-4 active" data-bs-toggle="tab" href="#kt_advanced">
                                <!--begin::Svg Icon | path: assets/media/icons/duotune/files/fil005.svg-->
                                <span class="svg-icon svg-icon-muted svg-icon-1 px-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                        <path opacity="0.3" d="M19 22H5C4.4 22 4 21.6 4 21V3C4 2.4 4.4 2 5 2H14L20 8V21C20 21.6 19.6 22 19 22ZM16 13.5L12.5 13V10C12.5 9.4 12.6 9.5 12 9.5C11.4 9.5 11.5 9.4 11.5 10L11 13L8 13.5C7.4 13.5 7 13.4 7 14C7 14.6 7.4 14.5 8 14.5H11V18C11 18.6 11.4 19 12 19C12.6 19 12.5 18.6 12.5 18V14.5L16 14C16.6 14 17 14.6 17 14C17 13.4 16.6 13.5 16 13.5Z" fill="black" />
                                        <rect x="11" y="19" width="10" height="2" rx="1" transform="rotate(-90 11 19)" fill="black" />
                                        <rect x="7" y="13" width="10" height="2" rx="1" fill="black" />
                                        <path d="M15 8H20L14 2V7C14 7.6 14.4 8 15 8Z" fill="black" />
                                    </svg>
                                </span>
                                <!--end::Svg Icon-->افزودن فایل
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-active-primary p-4 " data-bs-toggle="tab" href="#kt_general">

                                <!--begin::Svg Icon | path: assets/media/icons/duotune/files/fil004.svg-->
                                <span class="svg-icon svg-icon-muted svg-icon-1 px-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                        <path opacity="0.3" d="M19 22H5C4.4 22 4 21.6 4 21V3C4 2.4 4.4 2 5 2H14V4H6V20H18V8H20V21C20 21.6 19.6 22 19 22Z" fill="black" />
                                        <path d="M15 8H20L14 2V7C14 7.6 14.4 8 15 8Z" fill="black" />
                                    </svg>
                                </span>
                                <!--end::Svg Icon-->   افزودن  موردی

                            </a>
                        </li>

                    </ul>





                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="kt_advanced" role="tab-panel">

                            <div class="card w-100">


                                    <div class="card-body  row">
                                        <div class="col-md-7 fv-row">
                                            <div class="d-flex flex-stack mb-3">
                                                <label class=" fs-6 mb-2 min-w-50px"><span class=" min-w-100"> فایل</span></label>
                                            <input asp-for="FileName" type="file" class="form-control form-control-solid mb-4" id="formFile" name="formFile" placeholder="فایل  را وارد کنید" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel" />
                                        
                                           
                                        </div>
                                        </div>     
                                        <div class="col-md-5 fv-row">
                                            <div class="d-flex flex-stack mb-3">
   
                                                <a href="/Files/ImportCustomers.xlsx" class=" btn btn-bg-light btn-color-primary me-2 mb-2">دانلود فایل نمونه</a>
                                        </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        <div class="tab-pane fade" id="kt_general" role="tab-panel">

                            <div class="card w-100">

                                <div class="card-body  p-2">

                                        <div class="fv-row">
                                            <div class="card mb-6 mb-xl-9">
                                            
                                                <div class="card-body pt-0 scroll h-250px px-0" id="kt_main_table">
                                                    <table class="table align-middle table-row-dashed fs-6 mb-0 table-striped" id="kt_view_table">
                                                        <thead>
                                                            <tr class="text-start fw-bolder fs-7 text-uppercase gs-0">

                                                                <th class="w-100px">نام </th>
                                                                <th class="min-w-100px">نام خانوادگی  </th>
                                                                <th class="w-100px required"> شماره تماس  </th>
                                                                <th class="w-100px">کد پرسنلی</th>
                                                                <th class="w-100px">کد شعبه</th>
                                                                <th class="w-100px">کد خدمت</th>
                                                                <th class="w-50px text-end px-5">حذف  </th>
                                                            </tr>
                                                        </thead>
                                                        <tbody class="fw-bold text-gray-600 tableTbodyCount" id="kt_view_table">
                                                          
                                                         
                                                        </tbody>
                                                        <tfoot>


                                                        <tr>
                                                            <td colspan="2"><input type="button" id="btnAddNew" value="افزودن ردیف" class="btn btn-sm btn-light-primary" data-kt-stepper-action="submit" /></td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>



                </div>




                <div class="modal-footer flex-end">
                    <button type="reset" id="kt_modal_add_cancel" data-bs-dismiss="modal" aria-label="Close" class="btn btn-light me-3">انصراف</button>
                    <button id="kt_modal_add_submit" class="btn btn-primary" type="button" data-kt-stepper-action="submit">

                        <span class="indicator-label">تایید</span>
                        <span class="indicator-progress">
                            Please wait...
                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                        </span>
                    </button>

                </div>

            </form>


        </div>
    </div>

</div>

<script>
    function ChangeText() {

        var checkbox = document.getElementById("IsActiveCheck");
        var text = document.getElementById("IsActiveText");

        if (checkbox.checked == true) {
            text.innerHTML = " فعال";
        }
        else {
            text.innerHTML = " غیر فعال";
        }
    };


</script> 
@section Scripts {

    <link href="~/assets/js/jalalidatepicker.min.css" rel="stylesheet" />
    <script src="~/assets/js/jalalidatepicker.min.js"></script>

    <script>
        jalaliDatepicker.startWatch({
            zIndex: '9999'
        });

    </script>

}

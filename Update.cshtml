                                                                <label class="form-label">
                                                                    حداکثر حجم هر فایل
                                                                    <span class="text-muted">
                                                                        (MB)
                                                                    </span>
                                                                </label>

                                                                <input type="number"
                                                                       id="AttachmentMaxFileSizeMB"

                                                                <label class="form-label">
                                                                    حداکثر تعداد فایل
                                                                </label>

                                                                <input type="number"
                                                                       id="AttachmentMaxFiles"
                                                                       class="form-control"
                                                                       min="1"
                                                                       value="@(Model.AttachmentSetting?.MaxFiles ?? 1)" />

                                                            </div>



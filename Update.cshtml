                                                                </div>

                                                                <div class="fv-row mb-4">
                                                                    <label class="fs-6 fw-bold mb-2">
                                                                        تصویر
                                                                    </label>

                                                                    <input type="file"
                                                                           name="VoteQuestionMedias[0].ImageFile"
                                                                           class="form-control form-control-solid"
                                                                           accept="image/*" />
                                                                </div>

                                                                <input type="hidden"
                                                                       name="VoteQuestionMedias[0].VoteQuestionMediaId"
                                                                       value="0" />

                                                                <input type="hidden"
                                                                       name="VoteQuestionMedias[0].VoteQuestionId"
                                                                       value="@Model.VoteQuestionId" />

                                                                <input type="hidden"
                                                                       name="VoteQuestionMedias[0].OrderIndex"
                                                                       value="1" />

                                                                <input type="hidden"
                                                                       name="VoteQuestionMedias[0].ImageUrl"
                                                                       value="" />
                                                            </div>
                                                        }

                                                    </div>
                                                </div>
                                            </div>


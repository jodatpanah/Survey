                                                            </label>

                                                            <textarea asp-for="Description"
                                                                      id="DisplayContentDescription"
                                                                      class="form-control form-control-solid"
                                                                      rows="5"
                                                                      placeholder="متن نمایشی را وارد نمایید"></textarea>
                                                        </div>


                                                        @if (displayMedias.Any())
                                                        {
                                                            <div id="DisplayContentExistingMediaList">

                                                                @for (int i = 0; i < displayMedias.Count; i++)
                                                                {
                                                                    var media = displayMedias[i];

                                                                    <div class="border border-gray-300 rounded p-5 mb-6 bg-light">

                                                                        <div class="row g-5 align-items-start">

                                                                            <div class="col-md-4">
                                                                                @if (!string.IsNullOrWhiteSpace(media.ImageUrl))
                                                                                {
                                                                                    <div class="mb-3">
                                                                                        <img src="@media.ImageUrl"
                                                                                             alt="@media.Caption"
                                                                                             class="w-100 rounded"
                                                                                             style="max-height: 220px; object-fit: cover;" />
                                                                                    </div>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <div class="d-flex align-items-center justify-content-center rounded bg-secondary bg-opacity-10 text-muted"
                                                                                         style="height:220px;">
                                                                                        تصویری ثبت نشده است
                                                                                    </div>
                                                                                }
                                                                            </div>

                                                                            <div class="col-md-8">

                                                                                <div class="fv-row mb-4">
                                                                                    <label class="fs-6 fw-bold mb-2">
                                                                                        توضیح تصویر
                                                                                    </label>

                                                                                    <input type="text"
                                                                                           name="VoteQuestionMedias[@i].Caption"
                                                                                           class="form-control form-control-solid"
                                                                                           value="@media.Caption"
                                                                                           placeholder="توضیح تصویر را وارد نمایید" />
                                                                                </div>

                                                                                <div class="fv-row mb-4">
                                                                                    <label class="fs-6 fw-bold mb-2">
                                                                                        جایگزینی تصویر
                                                                                    </label>

                                                                                    <input type="file"
                                                                                           name="VoteQuestionMedias[@i].ImageFile"
                                                                                           class="form-control form-control-solid"
                                                                                           accept="image/*" />
                                                                                </div>

                                                                                <div class="fv-row mb-2">
                                                                                    <label class="fs-6 fw-bold mb-2">
                                                                                        اولویت نمایش
                                                                                    </label>

                                                                                    <input type="number"
                                                                                           name="VoteQuestionMedias[@i].OrderIndex"
                                                                                           class="form-control form-control-solid"
                                                                                           value="@media.OrderIndex"
                                                                                           min="1" />
                                                                                </div>

                                                                                <input type="hidden"
                                                                                       name="VoteQuestionMedias[@i].VoteQuestionMediaId"
                                                                                       value="@media.VoteQuestionMediaId" />

                                                                                <input type="hidden"
                                                                                       name="VoteQuestionMedias[@i].VoteQuestionId"
                                                                                       value="@media.VoteQuestionId" />

                                                                                <input type="hidden"
                                                                                       name="VoteQuestionMedias[@i].ImageUrl"
                                                                                       value="@media.ImageUrl" />
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }

                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="border border-dashed border-gray-300 rounded p-5 mb-6">
                                                                <div class="fv-row mb-4">
                                                                    <label class="fs-6 fw-bold mb-2">
                                                                        توضیح تصویر
                                                                    </label>

                                                                    <input type="text"
                                                                           name="VoteQuestionMedias[0].Caption"
                                                                           class="form-control form-control-solid"

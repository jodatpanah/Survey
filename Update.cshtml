                                                               data-bs-toggle="tooltip"
                                                               title="این نوع سوال برای نمایش متن و تصویر در پرسشنامه استفاده می‌شود"></i>
                                                        </label>
                                                    </div>

                                                    <div class="separator my-3"></div>


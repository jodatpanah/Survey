                                                <input type="tel"
                                                       id="PreCodeMobileNumber"
                                                       autocomplete="off"
                                                       class="persian-digits"
                                                       readonly
                                                       value="+98" />

                                            </div>

                                            <span class="survey-mobile-field-divider"></span>

                                            <div class="survey-mobile-input">

                                                <input type="tel"
                                                       id="MobileNumber"
                                                       inputmode="numeric"
                                                       onkeypress="return isNumberKey(event)"
                                                       autocomplete="tel"
                                                       class="persian-digits"
                                                       placeholder="9121234567"
                                                       value=""
                                                       maxlength="11" />

                                            </div>

                                        </div>

                                        <p class="alertFild survey-mobile-login-error"></p>

                                        <button type="button"
                                                id="sendOtpBtn"
                                                class="survey-mobile-login-submit"
                                                aria-busy="false">

                                            <span class="survey-mobile-login-submit-content">

                                                <span>
                                                    ارسال کد تأیید
                                                </span>

                                                <span class="survey-mobile-login-submit-icon">
                                                    <i class="fa fa-angle-left"></i>
                                                </span>

                                            </span>


                                            <span class="survey-mobile-login-submit-loading">

                                                <span class="survey-mobile-login-spinner"></span>

                                                <span>
                                                    در حال ارسال...
                                                </span>

                                            </span>

                                        </button>
                                        
                                    </div>

                                </div>

                            </div>

                        </div>

                        @* getOtpNumberBox *@
                        <div class="LoginStep2 d-none">

                            <div class="survey-otp-screen">

                                <div class="survey-otp-content">

                                    <!-- Logo + Survey title -->
                                    <div class="survey-otp-brand">

                                        <div class="survey-otp-logo-wrap">
                                            <img src="~/images/logo/logo-yaas.png"
                                                 alt="یاس ارغوانی"
                                                 class="survey-otp-logo" />
                                        </div>

                                        <div class="survey-mobile-login-package-title survey-otp-package-title">
                                        </div>

                                    </div>


                                    <!-- Step title -->
                                    <div class="survey-otp-heading">

                                        <h2 class="survey-otp-title">
                                            تأیید شماره موبایل
                                        </h2>

                                        <p class="survey-otp-description">
                                            کد ۶ رقمی ارسال‌شده را وارد نمایید.
                                        </p>

                                    </div>


                                    <!-- Mobile number -->
                                    <button type="button"
                                            class="survey-otp-mobile"
                                            onclick="editNumber()">

                                        <span class="survey-otp-mobile-info">

                                            <span class="survey-otp-phone-icon">
                                                <i class="fa fa-mobile"></i>
                                            </span>

                                            <span id="MobileNumberEnterByUser"
                                                  class="persian-digits survey-otp-mobile-number"></span>

                                        </span>


                                        <span class="survey-otp-edit">
                                            ویرایش شماره

                                            <i class="fa fa-pencil"></i>
                                        </span>

                                    </button>


                                    <!-- OTP Card -->
                                    <div class="survey-otp-card">

                                        <label class="survey-otp-label">
                                            کد تأیید
                                        </label>


                                        <div class="otpCodeBox survey-otp-code-area">

                                            @switch (Model.ProcessTypeData.SurveyTypeName)
                                            {
                                                case 3: // SMS

                                                    <div class="survey-otp-single-input">

                                                        <input type="tel"
                                                               id="CodeOtp"
                                                               inputmode="numeric"
                                                               class="input persian-digits"
                                                               placeholder="ــــــ"
                                                               autocomplete="one-time-code"
                                                               onkeypress="return isNumberKey(event)" />

                                                    </div>

                                                    break;


                                                case 5: // QRTerminal

                                                    <div class="survey-otp-single-input">

                                                        <input type="tel"
                                                               id="CodeOtp"
                                                               inputmode="numeric"
                                                               class="input persian-digits"
                                                               placeholder="کد تأیید"
                                                               autocomplete="one-time-code"
                                                               onkeypress="return isNumberKey(event)" />

                                                    </div>

                                                    break;


                                                default:

                                                    <div class="otp-container survey-otp-boxes"
                                                         id="otpContainer">

                                                        <input type="tel"
                                                               id="otpHidden"
                                                               autocomplete="one-time-code"
                                                               style="
                                                        position:absolute;
                                                        opacity:0;
                                                        pointer-events:none;
                                                        width:0;
                                                        height:0;
                                                        "
                                                               tabindex="-1" />


                                                        <input type="tel"
                                                               inputmode="numeric"
                                                               class="input otp-input persian-digits"
                                                               maxlength="1"
                                                               autocomplete="one-time-code"
                                                               onkeypress="return isNumberKey(event)" />

                                                        <input type="tel"
                                                               inputmode="numeric"
                                                               class="input otp-input persian-digits"
                                                               maxlength="1"
                                                               autocomplete="one-time-code"
                                                               onkeypress="return isNumberKey(event)" />

                                                        <input type="tel"
                                                               inputmode="numeric"
                                                               class="input otp-input persian-digits"
                                                               maxlength="1"
                                                               autocomplete="one-time-code"
                                                               onkeypress="return isNumberKey(event)" />

                                                        <input type="tel"
                                                               inputmode="numeric"
                                                               class="input otp-input persian-digits"
                                                               maxlength="1"
                                                               autocomplete="one-time-code"
                                                               onkeypress="return isNumberKey(event)" />

                                                        <input type="tel"
                                                               inputmode="numeric"
                                                               class="input otp-input persian-digits"
                                                               maxlength="1"
                                                               autocomplete="one-time-code"
                                                               onkeypress="return isNumberKey(event)" />

                                                        <input type="tel"
                                                               inputmode="numeric"
                                                               class="input otp-input persian-digits"
                                                               maxlength="1"
                                                               autocomplete="one-time-code"
                                                               onkeypress="return isNumberKey(event)" />

                                                    </div>

                                                    break;
                                            }


                                            <!-- Timer -->
                                            <div id="app"
                                                 class="otp-timer-neo survey-otp-timer"
                                                 dir="rtl">

                                                <div class="otp-timer-neo__card base-timer survey-otp-timer-card">

                                                    <div class="survey-otp-timer-row">

                                                        <span class="survey-otp-timer-title">
                                                            زمان باقی‌مانده
                                                        </span>

                                                        <span id="base-timer-label"
                                                              class="otp-timer-neo__label survey-otp-timer-value"></span>

                                                    </div>


                                                    <div class="otp-timer-neo__progress survey-otp-progress">

                                                        <div id="base-timer-progress-remaining"
                                                             class="otp-timer-neo__progress-bar survey-otp-progress-bar"></div>

                                                    </div>

                                                </div>


                                                <!-- Resend -->
                                                <button type="button"
                                                        onclick="SendAgain()"
                                                        id="textotpCodeBox"
                                                        class="hidden otp-timer-neo__resend survey-otp-resend">

                                                    <i class="fa fa-refresh"></i>

                                                    <span class="otp-timer-neo__resend-text">
                                                        ارسال مجدد کد
                                                    </span>

                                                </button>

                                            </div>

                                        </div>


                                        @* <p class="alertFild survey-otp-error"></p> *@


                                        <button type="button"
                                                class="survey-otp-submit"
                                                id="verifyOtpBtn"
                                                onclick="VerifiedOtp();">

                                            <span>
                                                تأیید و ادامه
                                            </span>

                                            <span class="survey-otp-submit-icon">
                                                <i class="fa fa-angle-left"></i>
                                            </span>

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>


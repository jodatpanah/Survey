@using Survey.FrameWork.common.SurveyIndex
@model SurveyIndexViewModel
@using System.Text.Json

@{
    Layout = "_Layout";
}

@{
    // Serialize directly in the view to a data attribute
    var votePackageDataJson = JsonSerializer.Serialize(Model.VotePackageData ?? (object)null);
    string escapedJson = votePackageDataJson.Replace("\"", "&quot;");
}

<!-- Use data attribute instead of value attribute - more CSP friendly -->
<input type="hidden" id="vote-package-data" data-vote-package="@Html.Raw(escapedJson)" />


<div class="DesktopBox">
    <div class="background background-desktop">

    </div>
    <div class="overlay"></div>
    <div class="DeskTopData HaveAnimation start-animation">
        <!-- موتور شکست نور (فقط یک‌بار در صفحه لازمه) -->
        <figure class="ServicesImage">
            <img class="mellat192" src="~/images/Logo/logo-yaas.png" />
        </figure>

            <div class="form-title StartPage" id="signup">
                <div class="TopInfo animatTop">
                    @*   <h2 class="text1"><img class="mellat32" src="/images/mellat32.png" /><span></span></h2> *@
                    <h3 class="TopInformation"></h3>
                </div>

            </div>
        <h1 class="text3 animatTop2">سامانه نظرسنجی یاس ارغوانی</h1>
    </div>

</div>

<div class="form-structor ">
    <div class="background background-mobile">
        @* <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span> *@

    </div>
    <div class="overlay"></div>
    <input id="ProcessTypeIdYaas" type="hidden" value="@Model.ProcessTypeData?.ProcessType?.ProcessTypeId" />
    <input id="typeLoad" value="@Model.ProcessTypeData.SurveyTypeName" type="hidden" />

    @switch (Model.ProcessTypeData.SurveyTypeName)
    {
        case 2: // QRCode
            <input id="VotePackageIsLoginMandatory" name="VotePackageIsLoginMandatory" value="@Model.VotePackageData?.IsLoginMandatory" type="hidden" />
            <input id="VotePackageId" name="VotePackageId" value="@Model.VotePackageData?.VotePackageId" type="hidden" />
            <input id="VotePackageReferenceId" name="VotePackageReferenceId" value="@Model.VotePackageData?.VotePackageReferenceId" type="hidden" />
            <input id="qrTypeId" name="qrTypeId" value="@Model.ProcessTypeData?.QrTypeId" type="hidden" />
            <input id="StructureId" name="StructureId" value="@Model.ProcessTypeData?.StructureId" type="hidden" />
            <input id="SurveyTypeId" name="SurveyTypeId" value="@Model.ProcessTypeData?.SurveyTypeId" type="hidden" />
            break;
        case 3: // SMS
            <input id="VotePackageIsLoginMandatory" name="VotePackageIsLoginMandatory" value="@Model.VotePackageData?.IsLoginMandatory" type="hidden" />
            <input id="SMSId" name="SMSId" value="@Model.VotePackageData?.VoteRequestSpecificationDetailSmsId" type="hidden" />
            <input id="VotePackageId" name="VotePackageId" value="@Model.VotePackageData?.VotePackageId" type="hidden" />
            <input id="VotePackageReferenceId" name="VotePackageReferenceId" value="@Model.VotePackageData?.VotePackageReferenceId" type="hidden" />
            <input id="SurveyTypeId" name="SurveyTypeId" value="@Model.ProcessTypeData?.SurveyTypeId" type="hidden" />
            break;
        case 5: // QRTerminal
            <input id="VotePackageIsLoginMandatory" name="VotePackageIsLoginMandatory" value="@Model.VotePackageData?.IsLoginMandatory" type="hidden" />
            <input id="VotePackageId" name="VotePackageId" value="" type="hidden" />
            <input id="VotePackageReferenceId" name="VotePackageReferenceId" value="@Model.VotePackageData?.VotePackageReferenceId" type="hidden" />
            <input id="DisplayTimeOut" name="DisplayTimeOut" value="@Model.ProcessTypeData.DisplayTimeOut" type="hidden" />
            break;
        default: // Link and others
            <input id="VotePackageIsLoginMandatory" name="VotePackageIsLoginMandatory" value="true" type="hidden" />
            <input id="VotePackageId" name="VotePackageId" value="" type="hidden" />
            break;
    }

    <div class="HaveAnimation">
        @* <div class="dataFirsPage StartPageSurvey"> *@

        <div id="backToHomeBranch" onclick="backToHomeBranch()">
            <span class="svg-icon svg-icon-muted svg-icon-2hx">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#fff">
                    <rect opacity="0.5" x="6" y="11" width="13" height="2" rx="1" fill="#fff" />
                    <path d="M8.56569 11.4343L12.75 7.25C13.1642 6.83579 13.1642 6.16421 12.75 5.75C12.3358 5.33579 11.6642 5.33579 11.25 5.75L5.70711 11.2929C5.31658 11.6834 5.31658 12.3166 5.70711 12.7071L11.25 18.25C11.6642 18.6642 12.3358 18.6642 12.75 18.25C13.1642 17.8358 13.1642 17.1642 12.75 16.75L8.56569 12.5657C8.25327 12.2533 8.25327 11.7467 8.56569 11.4343Z" fill="#fff" />
                </svg>
            </span>
            <h3>
                بازگشت به لیست
            </h3>
        </div>
        <div class="dataFirsPage ">
            <div class="MobileTopData ">
                <figure class="ServicesImage">
                    <img class="mellat192" src="~/images/Logo/logo-yaas.png" />
                </figure>
                <div class="form-title StartPage" id="signup">
                    <div class="TopInfo animatTop" style="align-items: center">
                       @*  <h2 class="text1">
                          <img class="mellat32" />
                              <span></span>
                        </h2> *@
                        <h3 class="TopInformation"></h3>
                    </div>
                </div>
            </div>
            <div class="DataBox HaveAnimation ">
                <div class="service-List LoginSteps ">
                    @* selectProcessType *@
                    <div class="card-selectServices d-none">
                        @if (Model.ProcessTypeData.TargetProcessType != null @* && Model.ProcessTypeData.TargetProcessType.Count > 3 *@)
                        {
                            <div class="titleText"><span>انتخاب خدمت:</span><div class="loadMoreTitle" onclick="LoadMore()">بیشتر</div></div>
                        }


                        <form class="moreDetails" method="get" asp-controller="ProcessTypeClient" asp-action="GetAllProcessTypeClient">
                            <input asp-for="@Model.ProcessTypeData.StructureId" value="@Model.ProcessTypeData.StructureId" type="hidden" />
                            <input asp-for="@Model.ProcessTypeData.QrTypeId" value="@Model.ProcessTypeData.QrTypeId" type="hidden" />
                            <input asp-for="@Model.ProcessTypeData.SurveyTypeId" value="@Model.ProcessTypeData.SurveyTypeId" type="hidden" />
                            <input id="JWT" type="hidden" value="@Model.ProcessTypeData.JwtToken" />
                            @* <input id="ProcessTypeCount" value="@Model.ProcessTypeData.ProcessType?.Count" type="hidden" /> *@
                            <input id="ProcessTypeCount" value="1" type="hidden" />
                            <input id="FullName" value="@Model.ProcessTypeData.FullName" type="hidden" />
                            <input id="TrackingCode" value="@Model.ProcessTypeData.TrackingCode" type="hidden" />

                            <div id="card-container" class="d-none">
                                @* @if (Model.ProcessTypeData.ProcessType?.Count > 0)
                                { *@
                                @* if (Model.ProcessTypeData.ProcessType.Count == 1)
                                { *@
                                <input id="ProcessTypeIdFirst" value="@Model.ProcessTypeData?.TargetProcessType?.ProcessTypeId ?? @Model.ProcessTypeData?.ProcessType?.ProcessTypeId" type="hidden" />
                                @* } *@
                                <div class="item1" onclick="getServicesCode(@Model.ProcessTypeData?.TargetProcessType?.ProcessTypeId ?? @Model.ProcessTypeData?.ProcessType?.ProcessTypeId)">
                                    <div class="imgBox"><img src="/images/png/006-calling.png" /></div>
                                    <span class="">@Model.ProcessTypeData?.TargetProcessType?.Name ?? @Model.ProcessTypeData?.ProcessType?.Name</span>
                                </div>
                                @* } *@
                            </div>
                        </form>
                    </div>

                    <div class="IsLoginMandatory">
                        @* getNumberBox *@
                        <div class="LoginStep1 d-none">

                            <div class="survey-mobile-login">

                                <div class="survey-mobile-login-content">

                                    <!-- Logo + Survey Title -->
                                    <div class="survey-mobile-login-brand">

                                        <div class="survey-mobile-login-logo-wrap">
                                            <img src="~/images/logo/logo-yaas.png"
                                                 alt="یاس ارغوانی"
                                                 class="survey-mobile-login-logo" />
                                        </div>

                                        <div class="survey-mobile-login-package-title"
                                             id="LoginSurveyTitle">
                                             
                                        </div>

                                    </div>


                                    <!-- Heading -->
                                    <div class="survey-mobile-login-heading">

                                        <h2 class="survey-mobile-login-title">
                                            ورود به نظرسنجی
                                        </h2>

                                        <p class="survey-mobile-login-description">
                                            لطفاً شماره موبایل خود را برای شرکت در نظرسنجی وارد نمایید.
                                        </p>

                                    </div>


                                    <!-- Form card -->
                                    <div class="survey-mobile-login-card">

                                        <label for="MobileNumber"
                                               class="survey-mobile-login-label">
                                            شماره موبایل
                                        </label>

                                        <div class="survey-mobile-number-field">

                                            <div class="survey-mobile-prefix">


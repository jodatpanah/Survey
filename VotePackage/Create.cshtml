@model Survey.FrameWork.common.VotePackage.CreateVotePackageCommand

@{
    ViewData["Title"] = "Create";

}

@section Styles {
    <link href="~/assets/css/CreateVotePackage.css" rel="stylesheet" />
    <link href="../assets/css/allowedUsers.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/VotePackageGraph.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    @* <link href="../assets/css/HierarchySelectorPartial.css" rel="stylesheet" type="text/css" /> *@
}

<div class="mb-5" id="setFormDetails">
    <div class="stepper stepper-pills" id="kt_stepper_example_clickable">
        <div class="card">
            <div class="card-header align-items-center py-3 gap-2 gap-md-5">
                <!-- این div را داخل یا بالای stepper wrapper قرار بده -->
                <div id="stepper-overlay" class="stepper-overlay">
                    <div class="stepper-overlay-content">
                        <h4 class="stepper-overlay-title">ابتدا نوع نظرسنجی را انتخاب کنید</h4>
                        <p class="stepper-overlay-desc">برای مشاهده و تکمیل مراحل، لطفاً نوع نظرسنجی مورد نظر خود را از بالای صفحه انتخاب نمایید.</p>
                    </div>
                </div>

                <div class="stepper-nav flex-center flex-wrap mx-auto w-100 mx-auto  mw-950px stepper-rtl">
                    <!--begin::Step 1-->
                    <div class="stepper-item current" data-kt-stepper-element="nav" data-kt-stepper-action="step">
                        <div class="stepper-topPart w-100 steper-100">
                            <div class="stepper-icon w-50px h-50px">
                                <i class="stepper-check fas fa-check"></i>
                                <span class="stepper-number">
                                    <span class="font-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="32" height="32">
                                            <defs>
                                                <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="100%">
                                                    <stop offset="0%" stop-color="#490a43" />
                                                    <stop offset="100%" stop-color="#7b1a6e" />
                                                </linearGradient>
                                            </defs>
                                            <rect width="64" height="64" rx="16" fill="url(#g1)" />
                                            <rect x="16" y="10" width="26" height="34" rx="4" fill="none" stroke="white" stroke-width="2.5" />
                                            <rect x="22" y="18" width="14" height="3" rx="1.5" fill="white" />
                                            <rect x="22" y="25" width="10" height="3" rx="1.5" fill="white" />
                                            <rect x="22" y="32" width="12" height="3" rx="1.5" fill="white" />
                                            <g transform="translate(39, 38) rotate(-45)">
                                                <rect x="-4" y="-12" width="8" height="16" rx="2" fill="#f0c4eb" />
                                                <polygon points="-4,4 4,4 0,11" fill="#e89dda" />
                                                <rect x="-4" y="-15" width="8" height="4" rx="1" fill="white" />
                                            </g>
                                        </svg>
                                    </span>
                                </span>
                            </div>
                            <div class="stepper-line  w-100"></div>
                        </div>
                        <div class="stepper-label px-4">
                            <h3 class="stepper-title">مرحله 1</h3>
                            <div class="stepper-desc">طراحی فرم</div>
                        </div>
                    </div>
                    <!--begin::Step 2-->
                    <div class="stepper-item" data-kt-stepper-element="nav" data-kt-stepper-action="step">
                        <div class="stepper-topPart w-100 steper-100">
                            <div class="stepper-icon w-50px h-50px">
                                <i class="stepper-check fas fa-check"></i>
                                <span class="stepper-number">
                                    <span class="font-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="32" height="32">
                                            <defs>
                                                <linearGradient id="g2" x1="0%" y1="0%" x2="100%" y2="100%">
                                                    <stop offset="0%" stop-color="#490a43" />
                                                    <stop offset="100%" stop-color="#9c1a8a" />
                                                </linearGradient>
                                            </defs>
                                            <rect width="64" height="64" rx="16" fill="url(#g2)" />
                                            <rect x="10" y="12" width="44" height="11" rx="5" fill="white" opacity="0.15" stroke="white" stroke-width="2" />
                                            <circle cx="20" cy="17.5" r="4" fill="#f0c4eb" />
                                            <rect x="28" y="15" width="20" height="4" rx="2" fill="white" />
                                            <rect x="10" y="27" width="44" height="11" rx="5" fill="white" opacity="0.15" stroke="white" stroke-width="2" />
                                            <circle cx="20" cy="32.5" r="4" fill="#e89dda" />
                                            <rect x="28" y="30" width="24" height="4" rx="2" fill="white" />
                                            <rect x="10" y="42" width="44" height="11" rx="5" fill="white" opacity="0.15" stroke="white" stroke-width="2" />
                                            <circle cx="20" cy="47.5" r="4" fill="#c96bb8" />
                                            <rect x="28" y="45" width="18" height="4" rx="2" fill="white" />
                                        </svg>
                                    </span>
                                </span>
                            </div>
                            <div class="stepper-line w-100"></div>
                        </div>
                        <div class="stepper-label px-4">
                            <h3 class="stepper-title">مرحله 2</h3>
                            <div class="stepper-desc"> لیست خدمت</div>
                        </div>
                    </div>
                    <!--begin::Step 3-->
                    <div class="stepper-item" data-kt-stepper-element="nav" data-kt-stepper-action="step">
                        <div class="stepper-topPart w-100 steper-100">
                            <div class="stepper-icon w-50px h-50px">
                                <i class="stepper-check fas fa-check"></i>
                                <span class="stepper-number">
                                    <span class="font-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="32" height="32">
                                            <defs>
                                                <linearGradient id="g3" x1="0%" y1="0%" x2="100%" y2="100%">
                                                    <stop offset="0%" stop-color="#490a43" />
                                                    <stop offset="100%" stop-color="#6b0f5e" />
                                                </linearGradient>
                                            </defs>
                                            <rect width="64" height="64" rx="16" fill="url(#g3)" />
                                            <rect x="13" y="14" width="34" height="40" rx="4" fill="none" stroke="white" stroke-width="2.5" />
                                            <rect x="23" y="9" width="14" height="9" rx="3" fill="white" />
                                            <rect x="20" y="26" width="6" height="6" rx="1.5" fill="none" stroke="#f0c4eb" stroke-width="2.5" />
                                            <polyline points="21,29 22.5,30.5 25.5,27" fill="none" stroke="#f0c4eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                            <rect x="30" y="27" width="14" height="3.5" rx="1.75" fill="white" />
                                            <rect x="20" y="36" width="6" height="6" rx="1.5" fill="none" stroke="#f0c4eb" stroke-width="2.5" />
                                            <polyline points="21,39 22.5,40.5 25.5,37" fill="none" stroke="#f0c4eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                            <rect x="30" y="37" width="18" height="3.5" rx="1.75" fill="white" />
                                            <text x="36" y="53" font-size="16" font-family="Arial" font-weight="900" fill="#f0c4eb" text-anchor="middle">?</text>
                                        </svg>
                                    </span>
                                </span>
                            </div>
                            <div class="stepper-line w-100"></div>
                        </div>
                        <div class="stepper-label px-4">
                            <h3 class="stepper-title">مرحله 3</h3>

                            <div class="stepper-desc"> پرسشنامه و شروط</div>
                        </div>
                    </div>
                    <!--begin::Step 4-->
                    <div class="stepper-item" data-kt-stepper-element="nav" data-kt-stepper-action="step">
                        <div class="stepper-topPart w-100 steper-100">
                            <div class="stepper-icon w-50px h-50px">
                                <i class="stepper-check fas fa-check"></i>
                                <span class="stepper-number">
                                    <span class="stepper-number">
                                        <span class="font-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="32" height="32">
                                                <defs>
                                                    <linearGradient id="g4" x1="0%" y1="0%" x2="100%" y2="100%">
                                                        <stop offset="0%" stop-color="#490a43" />
                                                        <stop offset="100%" stop-color="#8c1a7d" />
                                                    </linearGradient>
                                                </defs>
                                                <rect width="64" height="64" rx="16" fill="url(#g4)" />
                                                <circle cx="32" cy="20" r="8" fill="white" />
                                                <path d="M16,50 C16,38 48,38 48,50" fill="white" />
                                                <circle cx="12" cy="26" r="6" fill="white" opacity="0.8" />
                                                <path d="M2,50 C2,41 22,41 22,50" fill="white" opacity="0.8" />
                                                <circle cx="52" cy="26" r="6" fill="white" opacity="0.8" />
                                                <path d="M42,50 C42,41 62,41 62,50" fill="white" opacity="0.8" />
                                                <line x1="32" y1="20" x2="12" y2="26" stroke="#f0c4eb" stroke-width="2.5" stroke-dasharray="4,2" />
                                                <line x1="32" y1="20" x2="52" y2="26" stroke="#f0c4eb" stroke-width="2.5" stroke-dasharray="4,2" />
                                            </svg>
                                        </span>
                                    </span>
                                </span>
                            </div>
                            <div class="stepper-line  w-100"></div>
                        </div>
                        <div class="stepper-label px-4">
                            <h3 class="stepper-title">مرحله 4</h3>
                            <div class="stepper-desc">  خدمات دهندگان  </div>
                        </div>
                        <div class="stepper-line w-40px"></div>
                    </div>

                    <!--begin::Step 5-->
                    <div class="stepper-item" data-kt-stepper-element="nav" data-kt-stepper-action="step">
                        <div class="stepper-topPart w-100 steper-100">
                            <div class="stepper-icon w-50px h-50px">
                                <i class="stepper-check fas fa-check"></i>
                                <span class="stepper-number">
                                    <span class="font-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="32" height="32">
                                            <defs>
                                                <linearGradient id="g3" x1="0%" y1="0%" x2="100%" y2="100%">
                                                    <stop offset="0%" stop-color="#490a43" />
                                                    <stop offset="100%" stop-color="#9c1a8a" />
                                                </linearGradient>
                                            </defs>
                                            <!-- بک‌گراند مربعی با گوشه‌های گرد و گرادیانت یکپارچه -->
                                            <rect width="64" height="64" rx="16" fill="url(#g3)" />

                                            <!-- کاربر فرعی / پس‌زمینه (حالت لیست کاربران) -->
                                            <circle cx="43" cy="22" r="5.5" fill="#e89dda" opacity="0.6" />
                                            <path d="M33 41c0-4.5 4.5-8 10-8s10 3.5 10 8" fill="none" stroke="#e89dda" stroke-width="2.5" stroke-linecap="round" opacity="0.6" />

                                            <!-- کاربر اصلی / شاخص -->
                                            <circle cx="25" cy="23" r="7.5" fill="#f0c4eb" stroke="white" stroke-width="1.5" />
                                            <path d="M11 47c0-6.5 6.2-11.5 14-11.5s14 5 14 11.5" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" />
                                        </svg>
                                    </span>
                                </span>
                            </div>
                            <div class="stepper-line  w-100"></div>
                        </div>
                        <div class="stepper-label px-4">
                            <h3 class="stepper-title">مرحله 5</h3>
                            <div class="stepper-desc">  لیست کاربران  </div>
                        </div>
                        <div class="stepper-line w-40px"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="seprator"></div>
        <div class="card mt-5">
            <div class="card-header card-header-stretch">
                <div class="card-title d-flex align-items-center w-100 mx-auto  mw-950px">
                    <span class="svg-icon svg-icon-1 svg-icon-primary me-3 lh-0">
                        <i class="fa fa-clipboard-check fs-2  text-VotePackageTitle"></i>
                    </span>


                    <h3 class="m-0 text-gray-600 fs-5 ">
                        <span class="text-gray-600"> اطلاعات فرم نظرسنجی</span>
                        <span class="fw-bolder text-gray-900" id="VotePackageTitleGET"></span>
                    </h3>

                </div>
            </div>

            <div class="card-body">

                <div class="mx-auto w-100 pb-10 stepper-content">
                    <!--begin::Step 1-->
                    <div class="current" data-kt-stepper-element="content" data-original-step="1">
                        <div class="w-100 mx-auto  mw-950px">
                            <form id="add_question" class="mt-4">
                                @Html.AntiForgeryToken()
                                <div class="survey-section-card mb-8">

                                    <div class="fv-row mb-6">
                                        <label class="d-flex align-items-center fs-5 fw-bolder mb-2">
                                            <span class="required">انتخاب نوع نظرسنجی</span>
                                            <i class="fas fa-exclamation-circle ms-2 fs-7"
                                               data-bs-toggle="tooltip"
                                               title="انتخاب نوع نظرسنجی"></i>
                                        </label>

                                        <div class="text-muted fs-7">
                                            نوع نظرسنجی، ساختار و جریان کلی فرم را مشخص می‌کند.
                                        </div>
                                    </div>

                                    <div class="survey-type-list-wrapper" id="SurveyTypeList">
                                        <label class="survey-type-card">
                                            <input type="radio" name="SurveyTypeSelect" id="SurveyTypeId" value="4" />

                                            <div class="survey-card-body">
                                                <div class="survey-card-icon">
                                                    <div class="survey-type-img-container type-1">
                                                        <img src="\Icon\SurveyType\Link.svg" />
                                                    </div>
                                                </div>

                                                <div class="survey-card-content">
                                                    <div class="survey-card-title">لینک</div>
                                                    <div class="survey-card-subtitle">برای انتخاب کلیک کنید</div>
                                                </div>

                                                <div class="survey-card-check">
                                                    <i class="fas fa-check"></i>
                                                </div>
                                            </div>
                                        </label>

                                        <label class="survey-type-card">
                                            <input type="radio" name="SurveyTypeSelect" id="SurveyTypeId" value="3" />

                                            <div class="survey-card-body">
                                                <div class="survey-card-icon">
                                                    <div class="survey-type-img-container type-2">
                                                        <img src="\Icon\SurveyType\sms.svg" />
                                                    </div>
                                                </div>

                                                <div class="survey-card-content">
                                                    <div class="survey-card-title">پیامک</div>
                                                    <div class="survey-card-subtitle">برای انتخاب کلیک کنید</div>
                                                </div>

                                                <div class="survey-card-check">
                                                    <i class="fas fa-check"></i>
                                                </div>
                                            </div>
                                        </label>

                                        <label class="survey-type-card">
                                            <input type="radio" name="SurveyTypeSelect" id="SurveyTypeId" value="2" />

                                            <div class="survey-card-body">
                                                <div class="survey-card-icon">
                                                    <div class="survey-type-img-container type-3">
                                                        <img src="\Icon\Qr.svg" />
                                                    </div>
                                                </div>

                                                <div class="survey-card-content">
                                                    <div class="survey-card-title">کیو آر کد </div>
                                                    <div class="survey-card-subtitle">برای انتخاب کلیک کنید</div>
                                                </div>

                                                <div class="survey-card-check">
                                                    <i class="fas fa-check"></i>
                                                </div>
                                            </div>
                                        </label>
                                    </div>

                                    <div id="ErrorSurveyTypeList"
                                         class="fv-plugins-message-container invalid-feedback d-none text-center mt-5">
                                        <div>نوع نظرسنجی را انتخاب نمایید</div>
                                    </div>

                                </div>

                                <div class="survey-settings">
                                    <div class="fv-row">
                                        <label class="d-flex align-items-center fs-5 fw-bolder mb-4">
                                            <span class="required">تنظیمات فرم نظرسنجی</span>
                                            <i class="fas fa-exclamation-circle ms-2 fs-7" data-bs-toggle="tooltip" title=" تنظیمات فرم نظرسنجی"></i>
                                        </label>
                                    </div>

                                    <div class="setting-card">

                                        <div class="setting-info">
                                            <div class="setting-icon">
                                                <img src="assets/media/icons/duotune/general/gen029.svg">
                                            </div>

                                            <div>
                                                <div class="setting-title">نظرسنجی پیش فرض</div>
                                                <div class="setting-desc">این نظرسنجی به عنوان پیش فرض نمایش داده می‌شود</div>
                                            </div>
                                        </div>

                                        <label class="form-check form-switch form-check-custom form-check-solid">
                                            <input class="form-check-input" type="checkbox" asp-for="IsDefault" value="false" />
                                            <span class="form-check-label fw-bold text-muted"></span>
                                        </label>

                                    </div>


                                    <div class="setting-card">

                                        <div class="setting-info">
                                            <div class="setting-icon">
                                                <img src="assets/media/icons/duotune/general/gen051.svg">
                                            </div>

                                            <div>
                                                <div class="setting-title">اجبار احراز هویت</div>
                                                <div class="setting-desc">کاربر برای پاسخ باید وارد حساب شود</div>
                                            </div>
                                        </div>

                                        <label class="form-check form-switch form-check-custom form-check-solid">
                                            <input class="form-check-input" type="checkbox" checked="checked" asp-for="IsLoginMandatory" />
                                            <span class="form-check-label fw-bold text-muted"></span>
                                        </label>

                                    </div>


                                    <div class="setting-card">

                                        <div class="setting-info">
                                            <div class="setting-icon">
                                                <img src="assets/media/icons/duotune/general/gen048.svg">
                                            </div>

                                            <div>
                                                <div class="setting-title">وضعیت فعال</div>
                                                <div class="setting-desc">فعال یا غیرفعال بودن فرم</div>
                                            </div>
                                        </div>

                                        <label class="form-check form-switch form-check-custom form-check-solid">
                                            <input class="form-check-input" type="checkbox" checked="checked" asp-for="IsActive" />
                                            <span class="form-check-label fw-bold text-muted"></span>
                                        </label>

                                    </div>

                                </div>
                                <div class="mb-6 mt-2 row">
                                    <div class="col-md-6 col-md-6 fv-row fv-plugins-icon-container">
                                        <label for="Title" class="required fs-6 fw-bold mb-1">
                                            <span class="px-2"> عنوان  </span>
                                            <i class="fas fa-exclamation-circle ms-1 fs-7" data-bs-toggle="tooltip" title="حداکثر 200 کاراکتر می توانید وارد کنید"></i>
                                        </label>
                                        <input type="text" class="form-control form-control-solid" asp-for="Title" placeholder="عنوان نظرسنجی را وارد نمایید" maxlength="200" />
                                    </div>

                                    <div class="col-md-6 col-md-6 fv-row fv-plugins-icon-container">
                                        <label for="MaxParticipations" class=" fs-6 fw-bold mb-1">
                                            <span class="px-2">تعداد دفعات مجاز استفاده از لینک</span>
                                            <i class="fas fa-exclamation-circle ms-1 fs-7"
                                               data-bs-toggle="tooltip"
                                               title="در صورت استفاده مجدد از لینک میتوانید آن را وارد کنید">
                                            </i>
                                        </label>

                                        <input type="number"
                                               class="form-control form-control-solid"
                                               id="MaxParticipations"
                                               asp-for="MaxParticipations"
                                               min="0"
                                               max="100"
                                               step="1" />

                                    </div>

                                    @*     <div class="col-xs-12 col-md-6 fv-row fv-plugins-icon-container">
                                        <label for="WeightOfForm" class="fs-6 fw-bold mb-1">
                                            <span class="required"> وزن فرم </span>
                                            <span id="WeightValue" class="badge badge-light-primary ms-2">0</span>
                                        </label>
                                        <input type="range" max="10" value="0" min="-10" class="form-range WeightOfForm" id="WeightOfForm" name="WeightOfForm" dir="ltr" />
                                        <div class="d-flex justify-content-between mt-1">

                                            <small class="text-muted">10</small>
                                            <small class="text-muted">-10</small>

                                        </div>
                                        <div id="errorweightofformtitleid" class="fv-plugins-message-container invalid-feedback d-none"><div>وزن فرم را وارد نمایید</div></div>
                                    </div> *@





                                </div>

                                <div class="mb-6 fv-row">
                                    <div class="row">
                                        <div class="col-md-12 fv-row">
                                            <label for="WelcomePackageTitleId" class="fs-6 mb-2">
                                                <span class="required"> پیام پیشواز  </span>
                                            </label>
                                            <select class="form-select form-select-mb form-select-solid getdataClass" data-placeholder="انتخاب  پیام پیشواز" data-control="select2" id="WelcomePackageTitleId" name="WelcomePackageTitleId">
                                                <option disabled="disabled" selected="selected" value="default" id="defaultWelcomePackageTitleId">پیام پیشواز را انتخاب نمایید</option>
                                            </select>
                                            <div id="ErrorWelcomePackageTitleId" class="fv-plugins-message-container invalid-feedback d-none"><div>پیام پیشواز را انتخاب نمایید</div></div>

                                        </div>
                                    </div>
                                </div>


                                <div class="mb-6 fv-row">
                                    <div class="row">
                                        <div class="col-md-12 fv-row">
                                            <label for="GoodbyePackageTitleId" class="fs-6 mb-2">
                                                <span class="required">پیام بدرقه  </span>
                                            </label>
                                            <select class="form-select form-select-mb form-select-solid getdataClass" data-placeholder="انتخاب  پیام بدرقه" data-control="select2" id="GoodbyePackageTitleId" name="GoodbyePackageTitleId">
                                                <option disabled="disabled" selected="selected" value="default" id="defaultGoodbyePackageTitleId">پیام بدرقه انتخاب نمایید</option>
                                            </select>
                                            <div id="ErrorSurveyGoodbyePackageTitleId" class="fv-plugins-message-container invalid-feedback d-none"><div>پیام بدرقه انتخاب نمایید</div></div>

                                        </div>
                                    </div>
                                </div>


                                <div class="fv-row">
                                    <div class="row">
                                        <div class="col-md-6 mb-8  fv-row">
